{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/johnadeba/Desktop/ai-email-client && npx eslint --fix \"$CLAUDE_FILE_PATHS\" --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Claude Code] Running: $CLAUDE_TOOL_INPUT_COMMAND\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(vercel *)"
    ]
  },
  "agents": {
    "orchestrator": {
      "description": "Reads specs, coordinates feature work, reviews changes",
      "model": "claude-opus-4-7"
    },
    "email-adapter": {
      "description": "Implements and tests email provider integrations",
      "model": "claude-sonnet-4-6"
    },
    "ai-features": {
      "description": "Builds and tunes Claude prompts for email intelligence",
      "model": "claude-sonnet-4-6"
    },
    "ui": {
      "description": "Implements React components following design system",
      "model": "claude-sonnet-4-6"
    },
    "test": {
      "description": "Writes and maintains unit + integration test suites",
      "model": "claude-haiku-4-5-20251001"
    }
  }
}
